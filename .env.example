# Required environment variables
# Copy this file to .env and fill in values

# GitHub token (optional but recommended for higher rate limits)
GITHUB_TOKEN=

# Reddit credentials (for PRAW — optional, falls back to RSS if not set)
# Create a "script" app at https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Format: tool-name/version (by /u/username)
REDDIT_USER_AGENT=ai-tech-news-tracker/1.0

# YouTube Data API v3 key (optional — fallback for flaky RSS feeds)
# Get from: https://console.cloud.google.com/apis/credentials
# Enable "YouTube Data API v3" for your project
# Quota: 10,000 units/day (1 unit per channels.list, 1 unit per playlistItems.list)
YOUTUBE_API_KEY=

# Legacy optional provider credential; does NOT enable AI summaries.
OPENAI_API_KEY=

# Optional AI news summaries. Default is zero summarizer requests.
# All three must be set AND a local run must use --enable-ai-summary.
# Do not enable or run it without the operator's explicit approval: it may incur cost.
# SUMMARIZER_API_URL is the full chat-completions endpoint (HTTPS;
# loopback HTTP is allowed). No credentials/query/fragment in the URL.
SUMMARIZER_API_KEY=
SUMMARIZER_MODEL=
SUMMARIZER_API_URL=

# Notification settings
NOTIFICATION_CHANNEL=none  # telegram, discord, email, file, none
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_BOT_TOKEN=
DISCORD_CHANNEL_ID=
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASSWORD=

# Required only for hosted publishing. Use your own production Pages root.
# Example shape (not an operational deployment): https://example.pages.dev/
PUBLIC_REPORT_URL=
PUBLIC_REPORT_ATTACHMENT=false
# Comma-separated private owner/repository identities excluded from exports.
PRIVATE_REPOSITORIES=

# Optional local provider integration. No operator DB or state is distributed.
FREELLMAPI_DB_PATH=
FREELLMAPI_URL=http://localhost:3001

# Optional Cloudflare publishing; store these as encrypted CI secrets.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Non-secret project name is a repository variable, not a credential.
CLOUDFLARE_PAGES_PROJECT=

# Optional mirror; disabled by default and never required for the Pages host.
NETLIFY_MIRROR_ENABLED=false
NETLIFY_AUTH_TOKEN=
NETLIFY_SITE_ID=
